# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة تحكم Supabase
# لا تضع مفاتيح حقيقية أو service_role في مستودع Git أو في المتصفح

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# بوابات جاهزية صريحة للمصادقة (false افتراضيًا عبر عدم التعيين)
# اضبطها إلى true فقط بعد التحقق اليدوي من الإعدادات/الهجرات
#
# Phone كمعرّف هوية + كلمة مرور (ليس SMS OTP للدخول)
NEXT_PUBLIC_AUTH_PHONE_PASSWORD_READY=false
# توافق خلفي مع الاسم القديم (اختياري)
# NEXT_PUBLIC_AUTH_PHONE_PROVIDER_READY=false
#
# يجب تعطيل Phone confirmations في لوحة Auth ثم ضبط التالي.
# اختبار محلي فقط: غيّره إلى true ثم أعد تشغيل خادم التطوير.
# أعده false لإغلاق التسجيل. لا تنشر هذا التغيير قبل الإطلاق العام.
NEXT_PUBLIC_AUTH_PHONE_CONFIRMATIONS_DISABLED=false
#
# بعد تطبيق هجرات profiles/RLS بنجاح والتحقق اليدوي
NEXT_PUBLIC_DB_SCHEMA_READY=false

# للتزويد الإداري ولحفظ معرّف الفيديو على الخادم فقط — لا تضعه في NEXT_PUBLIC ولا في Git
# SUPABASE_SERVICE_ROLE_KEY=

# Mux — مفاتيح الخادم فقط. لا تضع أيًا منها في NEXT_PUBLIC.
# الأسماء هي الأسماء الرسمية لحزمة Mux.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY=
# MUX_PRIVATE_KEY=
# OWNER_PHONE=
# APPROVE_OWNER_PROVISION=no

# سر Send SMS Auth Hook (صيغة Standard Webhooks: v1,whsec_<base64>)
# يُضبط في Edge Function secrets ولوحة Authentication > Hooks — ليس NEXT_PUBLIC
# SEND_SMS_HOOK_SECRETS=
